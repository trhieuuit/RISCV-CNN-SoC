start_gui
open_project D:/Hoc_Tap/Dai_hoc/HK6/DoAn1/Pipeline_RISCV/Pipeline_RISCV.xpr
update_compile_order -fileset sources_1
open_run impl_1
synth_design -top tb_riscv -part xck26-sfvc784-2LV-c -lint 
launch_simulation
source tb_riscv.tcl
run 10000 ns
report_timing_summary -delay_type min_max -report_unconstrained -check_timing_verbose -max_paths 10 -input_pins -routable_nets -name timing_1
report_utilization -name utilization_1
close_sim
